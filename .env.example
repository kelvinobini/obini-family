# ---------------------------------------------------------------------------
# The Obini Family Tree — environment
#
# Local:  copy this to .env.local and fill it in. Never commit .env.local.
# Vercel: set the same names under Settings → Environment Variables.
#         (DATABASE_URL, DIRECT_URL and BLOB_READ_WRITE_TOKEN are injected
#         automatically when you attach Neon Postgres and Blob from the
#         Vercel dashboard — you do not paste those by hand.)
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Pooled connection, used by the running app.
DATABASE_URL="postgresql://user:password@host/obini?sslmode=require&pgbouncer=true"
# Unpooled connection, used only by `prisma migrate`. A pooler cannot run DDL.
# Locally, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/obini?sslmode=require"

# --- Secrets ---------------------------------------------------------------
# Signs session cookies and the short-lived media URLs. Must be 32+ chars.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Public origin. Used to build invitation and contributor links, so it must be
# the URL relatives actually open — your custom domain in production, not the
# *.vercel.app preview URL.
APP_URL="http://localhost:3000"

# --- Email delivery -------------------------------------------------------
# "console" prints sign-in codes, invitations and contributor links to the
# terminal, so you can use the whole app locally without a mail provider.
# Switch to "resend" before inviting real family — on Vercel there is no
# terminal for them to read.
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Obini Family <family@yourdomain.com>"

# --- Media storage --------------------------------------------------------
# "blob"  — Vercel Blob. The production setting. Files are written with
#           access: "private", so they have no public URL; the app reads them
#           server-side and serves them only through /api/media/[id].
# "local" — ./storage on disk. Development only: Vercel's filesystem is
#           read-only and is discarded on every deploy.
# "s3"    — any S3-compatible private bucket (AWS, Cloudflare R2, MinIO).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Set automatically by Vercel when you attach a Blob store.
BLOB_READ_WRITE_TOKEN=""

# Only needed when STORAGE_DRIVER="s3". The bucket must block all public access.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- First admin ----------------------------------------------------------
# The one account the seed promotes to primary admin. Nobody else can ever
# sign in without being invited by this person.
PRIMARY_ADMIN_EMAIL="you@yourdomain.com"
PRIMARY_ADMIN_NAME="Obini Family Admin"
